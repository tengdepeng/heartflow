<?xml version="1.0" encoding="utf-8"?>
<!-- 倒数日卡（2×2）：大数字 + 单位 + 心锚标题 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="#8A94AD"
        android:text="⏳ 倒数日" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:gravity="bottom">

        <TextView
            android:id="@+id/cd_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="38sp"
            android:textStyle="bold"
            android:textColor="#F4A88C"
            android:text="—" />

        <TextView
            android:id="@+id/cd_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:paddingBottom="6dp"
            android:textSize="12sp"
            android:textColor="#B6C0D8"
            android:text="天后" />
    </LinearLayout>

    <TextView
        android:id="@+id/cd_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textSize="12sp"
        android:textColor="#C6D0E8"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="回应用许一个心锚吧" />
</LinearLayout>
