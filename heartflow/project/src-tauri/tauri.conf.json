{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Heartflow",
  "version": "0.1.0",
  "identifier": "com.heartflow.app",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../frontend",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix ../frontend",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Heartflow 心流工坊",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "aura",
        "title": "Heartflow Aura",
        "width": 1280,
        "height": 800,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "alwaysOnTop": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
